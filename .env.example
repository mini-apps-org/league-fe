# league-be base URL. Required for `pnpm build`; `pnpm dev` falls back to http://localhost:9200.
VITE_API_URL=http://localhost:9200

# `pnpm dev` serves the /api/v1/sessions routes from MSW mocks (src/test/mocks/data/sessions.json)
# until league-be ships them; sign-in and /me still go to the real backend. Set `false` to send
# session requests to league-be too. Dev only; ignored by production builds.
VITE_API_MOCKS=true
